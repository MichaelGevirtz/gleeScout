# ---------------------------------------------------------------------------
# Backend — copy this file to `backend/.env` (that is the directory the
# backend runs from, so that is where `dotenv/config` looks). Never commit it.
# ---------------------------------------------------------------------------

# Google Gemini API key (used by backend LLM calls). Required.
GEMINI_API_KEY=

# Firecrawl API key (used by backend web research). Required.
FIRECRAWL_API_KEY=

# Gemini model override (optional, defaults in code to gemini-3.6-flash).
GEMINI_MODEL=

# Backend server port (optional, defaults to 3000).
PORT=3000

# ---------------------------------------------------------------------------
# Frontend — optional. Only needed if the backend is NOT on
# http://localhost:3000 (e.g. running Expo Go on a phone, which cannot reach
# the dev machine's "localhost"). Put it in `frontend/.env`.
# ---------------------------------------------------------------------------

# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
